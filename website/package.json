{
  "name": "viva-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "cd .. && go run ./tools/docs",
    "dev": "npm run generate && astro dev --host 127.0.0.1 --port 4321",
    "build": "npm run generate && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test viva-preview.test.mjs src/lib/preview.test.ts src/lib/i18n.test.ts src/lib/figures.test.ts src/lib/site.test.ts",
    "test:site": "node --test site.test.mjs",
    "sync:examples": "node sync-examples.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "bits-ui": "2.19.5",
    "cn": "0.3.0",
    "svelte": "5.57.2",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.0.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  }
}
