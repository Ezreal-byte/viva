---
import ThemeToggle from '../components/ThemeToggle.svelte';
import CodeCopy from '../components/CodeCopy.svelte';
import favicon from '../assets/viva-mark.svg?url';
import '../styles/global.css';
import { locales, languageNames, componentsPath, type Locale } from '../lib/i18n';
import { siteText } from '../lib/site';
import { homePath, docsPath, apiPath, type Section } from '../lib/routes';

interface Props {
  title: string;
  summary: string;
  locale: Locale;
  section: Section;
  // The same page in every language, so the language switch keeps the reader here.
  alternates: Record<Locale, string>;
}

const { title, summary, locale, section, alternates } = Astro.props;
const text = siteText(locale);
const navigation = [
  { section: 'docs', href: docsPath(locale), label: text.navDocs },
  { section: 'components', href: componentsPath(locale), label: text.navComponents },
  { section: 'api', href: apiPath(locale), label: text.navApi },
] as const;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{section === 'home' ? title : `${title} · Viva`}</title>
    {locales.map(language => <link rel="alternate" hreflang={language === 'zh' ? 'zh-CN' : 'en'} href={alternates[language]} />)}
    <script is:inline>
      try {
        const theme = localStorage.getItem('viva-docs-theme') === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{text.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homePath(locale)} aria-label={text.home}><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>viva</a>
        <nav class="header-navigation" aria-label={text.primaryNavigation}>{navigation.map(entry => <a href={entry.href} aria-current={section === entry.section ? 'page' : undefined}>{entry.label}</a>)}</nav>
        <div class="header-end"><a class="repository-link" href="https://github.com/vivaui/viva" target="_blank" rel="noopener noreferrer" aria-label={text.repository} title={text.repository}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/></svg></a><nav class="language-switch" aria-label={text.language}>{locales.map(language => <a href={alternates[language]} lang={language === 'zh' ? 'zh-CN' : 'en'} hreflang={language === 'zh' ? 'zh-CN' : 'en'} aria-current={language === locale ? 'page' : undefined} aria-label={languageNames[language]}>{language === 'zh' ? '中文' : 'EN'}</a>)}</nav><ThemeToggle {locale} client:load /></div>
      </div>
    </header>
    <slot />
    <CodeCopy {locale} client:load />
    <footer class="site-footer"><span><strong>viva</strong></span></footer>
  </body>
</html>
